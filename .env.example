# Database (CRITICAL: Prisma ONLY reads from .env, not .env.local)
# Copy this file to .env (not .env.local) for Prisma to work correctly
DATABASE_URL="postgresql://username:password@localhost:5432/omnipulse?schema=public"

# Next.js
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Test Mode (set to 'true' to use mock data instead of real APIs)
TEST_MODE="false"

# Data Source API Keys (for simulation)
FACEBOOK_PIXEL_ID="demo_pixel"
GOOGLE_ADS_CLIENT_ID="demo_client"

# Real API Keys (for production)
GOOGLE_ADS_DEVELOPER_TOKEN="your-google-ads-developer-token"

# Shopify Authentication (configured via UI)
# Users will enter their shop domain (e.g., mystore.myshopify.com) and API token through the connection modal
# No environment variables needed for Shopify - all credentials stored securely per connection